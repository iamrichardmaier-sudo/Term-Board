# Copy to .env and fill in. .env is gitignored.

# --- BYU ---
BYU_NETID=rbm66

# --- Supabase (same project as Wazn) ---
# The publishable anon key is not a secret; row-level security is what protects
# the rows. The scraper signs in as you, exactly like the Scriptable widget.
SUPABASE_URL=https://fphpcfecgnfoogfaeihu.supabase.co
SUPABASE_ANON_KEY=
# Must match DEFAULT_EMAIL in scriptable/TermBoard.js — see the note there.
SUPABASE_EMAIL=rbm66@byu.edu
# Leave SUPABASE_PASSWORD unset on Windows — `npm run login` stores it with DPAPI.
SUPABASE_PASSWORD=

# --- Behaviour ---
TERM_BOARD_HEADLESS=true
TERM_BOARD_TIMEZONE=America/Denver
